{ #category : #'as yet unclassified' }
ABAPParser >> nextChained [
	| node chained context |
	node := nodeStack removeLast.
	stateStack removeLast.
	chained := nodeStack last.
	(self isChained: chained) ifFalse: [ ^ self killState ].
	chained second add: node.
	stateStack addAll: chained third.
	nodeStack addAll: (chained fourth collect: #copy).
	currentToken := nil.
	context := thisContext.
	[ context selector = #reduce: ] whileFalse: [ context := context sender ].
	context return: nil
]

