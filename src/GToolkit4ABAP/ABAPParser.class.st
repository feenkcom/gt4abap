{ #category : #styling }
ABAPParser class >> smaccStyler: aParserClass [
	"This is a generic styler that does a little formatting for any parser"

	<smaccStyler: #ABAPParser priority: 10>
	^ (GtSmaCCParserStyler forParser: aParserClass)
		stylerRules: {(GtSmaCCNodeVariableStylerRule
					nodeClassName: #ABAPRootNode
					variableNames: #(keywords keyword)
					styleBlock: [ :styler | 
						styler
							bold;
							foreground: Color purple ]) continueOnMatch: true.
				(GtSmaCCNodeVariableStylerRule
					nodeClassName: #ABAPRootNode
					variableNames: #(period)
					styleBlock: [ :styler | styler bold ]) continueOnMatch: true.
				(GtSmaCCNodeStylerRule
					nodeClassName: #ABAPIntegerNode
					styleBlock: [ :styler | styler foreground: Color blue ])
					continueOnMatch: true.
				(GtSmaCCNodeStylerRule
					nodeClassName: #ABAPStringNode
					styleBlock: [ :styler | styler foreground: Color blue ])
					continueOnMatch: true.
				(GtSmaCCNodeStylerRule
					nodeClassName: #ABAPConcatenatedStringNode
					styleBlock: [ :styler | styler foreground: Color blue ])
					continueOnMatch: true.
				GtSmaCCCommentStylerRule
					styleBlock: [ :styler | styler foreground: Color lightGray ].
				GtSmaCCNodeVariableStylerRule
					nodeClassName: #SmaCCErrorNode
					variableNames: #(dismissedTokens errorToken)
					styleBlock: [ :styler | styler foreground: Color red ]}
]

