{ #category : #'as yet unclassified' }
ABAPParser >> actionsForCurrentToken [
	| actions |
	currentToken ids first = scanner colonId ifTrue: [ ^ self startChained ].
	((self class statesWithNativeSQL includes: self currentState)
		and: [ self hasLanguageOption ])
		ifTrue: [ self createTokenFor: scanner NativeSQLId upTo: 'ENDMETHOD' ].
	[ actions := super actionsForCurrentToken.
	actions isEmpty and: [ currentToken value = ' .' ] ]
		whileTrue: [ currentToken := nil.
			self getNextToken ].
	(actions isEmpty and: [ currentToken ids includes: scanner pragmaId ])
		ifTrue: [ currentToken := nil.
			self getNextToken.
			^ self actionsForCurrentToken ].
	actions isEmpty
		ifTrue: [ self addActionsFor: scanner MacroContentId to: actions.
			actions notEmpty
				ifTrue: [ [ currentToken := nil.
					self getNextToken.
					currentToken value sameAs: 'END-OF-DEFINITION' ]
						whileFalse: [ currentToken value = '' ifTrue: [ ^ #() ] ].
					^ self actionsForCurrentToken ] ].
	^ actions
]

{ #category : #'as yet unclassified' }
ABAPParser >> createTokenFor: anInteger upTo: aString [
	| first last |
	first := currentToken.
	last := first.
	[ currentToken := nil.
	self getNextToken.
	(currentToken value sameAs: aString) or: [ currentToken value isEmpty ] ]
		whileFalse: [ last := currentToken ].
	self position: last stopPosition.
	currentToken := scanner tokenClass
			value: (scanner sourceFrom: first startPosition to: last stopPosition)
			start: first startPosition
			ids: {anInteger}
]

{ #category : #'as yet unclassified' }
ABAPParser >> hasLanguageOption [
	| index item |
	index := nodeStack size.
	[ index > 1 ]
		whileTrue: [ item := nodeStack at: index.
			(item isKindOf: OrderedCollection)
				ifTrue: [ item
						do: [ :each | 
							((each isKindOf: SmaCCToken) and: [ each value sameAs: 'LANGUAGE' ])
								ifTrue: [ ^ true ] ] ].
			((item isKindOf: SmaCCToken) and: [ item value sameAs: 'METHOD' ])
				ifTrue: [ ^ false ].
			index := index - 1 ].
	^ false
]

{ #category : #'as yet unclassified' }
