	| result |
	result := ABAPAddNode new.
	result addToken: (nodes at: 1) to: result keywords.
	result addNode: (nodes at: 2) to: result sources.
	result addToken: ((nodes at: 3) at: 1) to: result keywords.
	result to: ((nodes at: 3) at: 2).
	^ result
]

